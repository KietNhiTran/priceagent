# =============================================================================
# Azure OpenAI / AI Foundry Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# For managed identity in production, remove AZURE_OPENAI_API_KEY and use
# DefaultAzureCredential (set AZURE_OPENAI_USE_MANAGED_IDENTITY=true).
# =============================================================================

# Azure OpenAI endpoint (AI Foundry project endpoint)
AZURE_OPENAI_ENDPOINT=https://<your-foundry-project>.openai.azure.com/

# API key (for local dev — omit for managed identity)
AZURE_OPENAI_API_KEY=<your-api-key>

# Deployment names (must match your AI Foundry deployments)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# API version
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Use managed identity instead of API key (set to true for Azure deployment)
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

# =============================================================================
# Application Settings
# =============================================================================
DATA_DIR=../data
TRACE_DB_PATH=../data/traces.db
LOG_LEVEL=INFO
